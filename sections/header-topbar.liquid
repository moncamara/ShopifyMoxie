<div class="header-topbar">
    <div class="topbar-slider">
      {% for block in section.blocks %}
        <div class="topbar-slide">
          {% if block.settings.left_text %}
            <span class="topbar-left">{{ block.settings.left_text }}</span>
          {% endif %}
  
          {% if block.settings.image %}
            <img src="{{ block.settings.image | image_url: width: 40 }}" alt="Topbar icon" class="topbar-image">
          {% endif %}
  
          {% if block.settings.right_text %}
            <span class="topbar-right">{{ block.settings.right_text }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      $('.topbar-slider').slick({
        autoplay: true,
        arrows: false,
        dots: false,
        infinite: true,
        slidesToShow: 1,
        slidesToScroll: 1,
        speed: 500
      });
    });
  </script>
  


  {% schema %}
  {
    "name": "Topbar Carrusel",
    "tag": "section",
    "class": "topbar-section",
    "settings": [],
    "blocks": [
      {
        "type": "carrusel-topbar",
        "name": "Carrusel TopBar",
        "settings": [
          {
            "type": "text",
            "id": "left_text",
            "label": "Texto izquierdo"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Imagen"
          },
          {
            "type": "text",
            "id": "right_text",
            "label": "Texto derecho"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Topbar con carrusel"
      }
    ]
  }
  {% endschema %}
  
